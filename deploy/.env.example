# Listmonk CRM - Environment Variables
# Copy this file to .env and customize for your deployment

# Database Configuration
LISTMONK_DB_PASSWORD=your_secure_database_password_here

# Admin Account (optional - create via web interface if not set)
# LISTMONK_ADMIN_USER=admin
# LISTMONK_ADMIN_PASSWORD=your_admin_password

# Server Configuration
# LISTMONK_app__address=0.0.0.0:9000

# Email Configuration (configure in web interface after setup)
# LISTMONK_smtp__host=smtp.gmail.com
# LISTMONK_smtp__port=587
# LISTMONK_smtp__username=your_email@gmail.com
# LISTMONK_smtp__password=your_app_password

# Security
# LISTMONK_app__secret_key=your_secret_key_here
